{
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-ffi --allow-env --allow-net --watch main.ts",
    "test": "deno test -A",
    "build": "deno compile --allow-read --allow-write --allow-ffi --allow-env --allow-net --no-terminal --icon assets/ModCleaner.ico -o ./ModCleaner.exe ./main.ts",
    "build:linux": "deno compile --allow-read --allow-write --allow-ffi --allow-env --allow-net -o ./ModCleaner ./main.ts"
  },
  "imports": {
    "@miyauci/rfd/deno": "jsr:@miyauci/rfd@1/deno",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@1",
    "@std/testing/mock": "jsr:@std/testing@1/mock",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.21",
    "WebUI": "https://deno.land/x/webui/mod.ts"
  }
}
